# Development-only settings. Copy to .env before changing local values.
# Production must provision distinct secrets and the fixed non-superuser trax_app role out of band.
POSTGRES_DB=trax
POSTGRES_USER=trax_admin
POSTGRES_PASSWORD=trax-admin-development-only
POSTGRES_PORT=5432
TRAX_RUNTIME_DB_USER=trax_app
TRAX_RUNTIME_DB_PASSWORD=trax-application-development-only
TRAX_WEB_PORT=8080
# Host-run API/tests use trax_app; Alembic and test setup use trax_admin.
TRAX_DATABASE_URL=postgresql+asyncpg://trax_app:trax-application-development-only@127.0.0.1:5432/trax
TRAX_ADMIN_DATABASE_URL=postgresql+asyncpg://trax_admin:trax-admin-development-only@127.0.0.1:5432/trax
TRAX_MIGRATION_DATABASE_URL=postgresql+asyncpg://trax_admin:trax-admin-development-only@127.0.0.1:5432/trax
TRAX_COMPOSE_DATABASE_URL=postgresql+asyncpg://trax_app:trax-application-development-only@database:5432/trax
TRAX_COMPOSE_MIGRATION_DATABASE_URL=postgresql+asyncpg://trax_admin:trax-admin-development-only@database:5432/trax
TRAX_SESSION_COOKIE_SECURE=false
TRAX_SESSION_TTL_SECONDS=2592000
