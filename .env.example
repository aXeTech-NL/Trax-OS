# Development-only settings. Copy to .env before changing local values.
POSTGRES_DB=trax
POSTGRES_USER=trax
POSTGRES_PASSWORD=trax-development-only
POSTGRES_PORT=5432
TRAX_WEB_PORT=8080
# Host-run API/Alembic and container-network URLs intentionally use different hosts.
TRAX_DATABASE_URL=postgresql+asyncpg://trax:trax-development-only@127.0.0.1:5432/trax
TRAX_COMPOSE_DATABASE_URL=postgresql+asyncpg://trax:trax-development-only@database:5432/trax
TRAX_SESSION_COOKIE_SECURE=false
TRAX_SESSION_TTL_SECONDS=2592000
