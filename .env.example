# Development-only PostgreSQL/PostGIS settings. Copy to .env to override Compose defaults.
POSTGRES_DB=trax
POSTGRES_USER=trax
POSTGRES_PASSWORD=trax-development-only
POSTGRES_PORT=5432
TRAX_DATABASE_URL=postgresql+asyncpg://trax:trax-development-only@127.0.0.1:5432/trax
TRAX_SESSION_COOKIE_SECURE=false
TRAX_SESSION_TTL_SECONDS=2592000
