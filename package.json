{
  "name": "trax-os",
  "version": "0.1.0",
  "private": true,
  "description": "Trax OS public foundation",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/web",
    "packages/api-contract"
  ],
  "scripts": {
    "predev": "npm ci && uv sync --project apps/api --locked",
    "dev": "concurrently -k -n api,web -c blue,green \"uv run --project apps/api uvicorn trax_api.main:app --reload --port 18000\" \"npm run dev --workspace @trax-os/web\"",
    "generate": "node scripts/contracts.mjs generate",
    "contract:check": "node scripts/contracts.mjs check && node --test scripts/contracts.test.mjs scripts/contract-compatibility.test.mjs",
    "contract:compat": "node scripts/contract-compatibility.mjs",
    "architecture:check": "node scripts/architecture-decisions.mjs",
    "security:check": "node --test scripts/check-threat-model.test.mjs && node scripts/check-threat-model.mjs docs/security/phase-0-threat-model.json",
    "security:closure": "node scripts/check-threat-model.mjs docs/security/phase-0-threat-model.json --closure"
  },
  "devDependencies": {
    "api-smart-diff": "1.0.6",
    "concurrently": "9.1.2",
    "openapi-typescript": "7.8.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  }
}
