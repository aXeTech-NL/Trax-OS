{
  "name": "@trax-os/powersync-feasibility-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "toolchain:check": "node -e \"const p=require('node:path');const n=process.versions.node.split('.')[0];const e=process.env.npm_execpath??'';let v='0';try{v=require(p.resolve(p.dirname(e),'..','package.json')).version}catch{}if(n!=='22'||!v.startsWith('10.')){console.error('Issue #8 harness requires Node 22 and npm 10; found node '+process.version+' npm '+v);process.exit(2)}\"",
    "build": "tsc -p tsconfig.json",
    "precheck": "npm run toolchain:check",
    "check": "npm run build && npm run test:unit",
    "test:unit": "node --test lib/tests/unit.test.js",
    "pretest:integration": "npm run toolchain:check",
    "test:integration": "node --test lib/tests/integration.test.js",
    "restart:evidence": "node lib/src/restart-evidence.js",
    "prerecord:evidence": "npm run toolchain:check",
    "record:evidence": "node lib/src/record-evidence.js"
  },
  "dependencies": {
    "@powersync/node": "0.20.2",
    "better-sqlite3": "12.10.0",
    "jose": "6.2.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "@powersync/node@0.20.2": true,
    "better-sqlite3@12.10.0": true
  }
}
